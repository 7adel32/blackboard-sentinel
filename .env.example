# University LMS Configuration
LMS_URL="https://lms.university.edu"
LMS_USER_ID="your_student_id"
LMS_PASSWORD="your_lms_password"
LMS_STORAGE_DIR="~/Documents/University"
TRAY_THEME="auto"
# Save all announcements (including text-only) as .docx files in Announcements/ (announcements with files/URLs are always saved to Announcements/):
LMS_KEEP_ALL_ANNOUNCEMENTS="false"
# Default chat platform for notifications via Hermes (whatsapp, telegram)
HERMES_CHAT_PLATFORM="whatsapp"

LMS_HERMES_MESSAGING="false"

# Skip downloading any file larger than this many MB (0 = disabled, the default)
LMS_MAX_FILE_SIZE_MB="0"
# Parallel course checking worker threads (0 = unlimited, the default; 1 = sequential)
LMS_MAX_WORKERS="0"
