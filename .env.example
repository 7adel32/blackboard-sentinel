# University LMS Configuration
LMS_URL="https://lms.university.edu"
LMS_USER_ID="your_student_id"
LMS_PASSWORD="your_lms_password"
LMS_STORAGE_DIR="~/Documents/University"
TRAY_THEME="auto"
# Save all announcements as .docx files in Announcements/ (with .url files) instead of a Links/ folder:
LMS_KEEP_ALL_ANNOUNCEMENTS="false"
